# IPs y Puertos (¡Verifica que estas IPs sean correctas en tu red!)
LLAMA_PRINCIPAL_IP=192.168.0.50   # IP de la RTX 5060 Ti
LLAMA_PRINCIPAL_PORT=8080          # Puerto de tu script de bash
CLIENT_IP=192.168.0.100          # IP de esta máquina (RTX 1650)

# Paths
NFS_MOUNT_PATH=/data/source/practice      # Ruta real donde tienes tu código de Solidity/NextJS

# Modelos
EMBEDDING_MODEL=nomic-embed-text   # Excelente para código

# Seguridad
REDIS_PASSWORD=password_local_123  # Cambia por algo simple pero real
API_KEY=key_para_cline             # Esta es la que pondrás en Cline (VS Code)
GRAFANA_PASSWORD=admin             # Para ver las métricas en el puerto 3000

# Rendimiento
INDEX_INTERVAL=60                  # Re-indexar cada 1 minuto (ideal para desarrollo)
OLLAMA_NUM_GPU=35                  # Mayor uso de la RTX 1650 para velocidad



# Servicios
QDRANT_HOST=qdrant
QDRANT_PORT=6333
OLLAMA_HOST=ollama-embeddings
OLLAMA_PORT=11434
REDIS_HOST=redis