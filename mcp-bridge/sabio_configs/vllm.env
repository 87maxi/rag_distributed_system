# El Sabio — Configuración para vLLM
# ----------------------------------------------------------------
# vLLM expone la OpenAI API por defecto en /v1/chat/completions
# Arranque típico:
#   vllm serve Qwen/Qwen2.5-7B-Instruct --port 8080
# Documentación: https://docs.vllm.ai/en/latest/serving/openai_compatible_server.html
# ----------------------------------------------------------------
SABIO_BASE_URL=http://localhost:8080
SABIO_MODEL=Qwen/Qwen2.5-7B-Instruct
SABIO_API_KEY=none
SABIO_TIMEOUT=120
