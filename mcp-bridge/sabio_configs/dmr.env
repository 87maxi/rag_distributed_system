# El Sabio — Configuración para Docker Model Runner (DMR)
# ----------------------------------------------------------------
# DMR expone la OpenAI API en el puerto 12434 de host.docker.internal
# Desde dentro de Docker usar host.docker.internal; desde el host usar localhost.
# Documentación: https://docs.docker.com/ai/model-runner/
# ----------------------------------------------------------------
SABIO_BASE_URL=http://localhost:12434
SABIO_MODEL=ai/qwen2.5
SABIO_API_KEY=none
SABIO_TIMEOUT=60

# Para uso dentro de Docker:
# SABIO_BASE_URL=http://host.docker.internal:12434
