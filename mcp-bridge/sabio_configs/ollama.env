# El Sabio — Configuración para Ollama (local)
# ----------------------------------------------------------------
# Ollama expone /v1/chat/completions desde v0.1.24+
# Documentación: https://ollama.com/blog/openai-compatibility
# ----------------------------------------------------------------
SABIO_BASE_URL=http://localhost:11434
SABIO_MODEL=qwen2.5:0.5b
SABIO_API_KEY=none
SABIO_TIMEOUT=30

# Uso:
#   export $(cat sabio_configs/ollama.env | grep -v '#') && python3 stdio_server.py
#   -o-
#   docker run ... --env-file mcp-bridge/sabio_configs/ollama.env ...
